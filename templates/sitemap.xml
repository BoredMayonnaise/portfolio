{% load static %}<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://markocampos.rhymvex.space/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://markocampos.rhymvex.space/projects/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  {% for project in projects %}
  <url>
    <loc>https://markocampos.rhymvex.space{{ project.get_absolute_url }}</loc>
    <lastmod>{{ project.created_at|date:"Y-m-d" }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}
  <url>
    <loc>https://markocampos.rhymvex.space/blog/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  {% for post in posts %}
  <url>
    <loc>https://markocampos.rhymvex.space{{ post.get_absolute_url }}</loc>
    <lastmod>{{ post.created_at|date:"Y-m-d" }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endfor %}
  <url>
    <loc>https://markocampos.rhymvex.space/contact/</loc>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
</urlset>
