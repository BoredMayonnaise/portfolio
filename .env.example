# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Django secret key — generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Set to true only in local development. Never true in production.
DJANGO_DEBUG=false

# Comma-separated list of hosts/domains allowed to serve the site.
# In production put your real domain here, e.g. yoursite.com,www.yoursite.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# The secret path where the REAL admin lives (/admin/ is a honeypot).
# Pick something long and unguessable, e.g. 5f9c-x2admin-7q31/
DJANGO_ADMIN_URL=django-admin-secure/

# Optional: origins allowed to submit POST/CSRF requests, comma-separated.
# In production set these to your https origins, e.g.
#   https://yoursite.com,https://www.yoursite.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional: number of proxy hops when the app sits behind a TLS proxy
# (e.g. nginx/cloudflare). Set only if brute-force lockouts misidentify IPs.
# DJANGO_PROXY_COUNT=1

# Email — contact-form notifications via Gmail SMTP.
# In DEBUG, falls back to printing emails to the console unless these are set.
DJANGO_EMAIL_HOST_USER=you@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=your-16-char-gmail-app-password
# Where notifications are delivered (defaults to DJANGO_EMAIL_HOST_USER).
DJANGO_CONTACT_TO_EMAIL=you@gmail.com
# Operational alerts (500 errors, rate-limit hits). Defaults to DJANGO_CONTACT_TO_EMAIL.
DJANGO_ADMIN_EMAIL=you@gmail.com
# "From" for admin/alert emails (defaults to DJANGO_EMAIL_HOST_USER).
# DJANGO_SERVER_EMAIL=you@gmail.com
# Optional overrides:
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_DEFAULT_FROM_EMAIL=you@gmail.com
