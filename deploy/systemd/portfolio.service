[Unit]
Description=gunicorn daemon for portfolio
Requires=portfolio.socket
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/portfolio
Environment="PYTHONPATH=/home/ubuntu/portfolio"
ExecStart=/home/ubuntu/portfolio/venv/bin/python3 -m gunicorn \
          --access-logfile - \
          --workers 3 \
          --bind unix:/run/portfolio.sock \
          portfolio.wsgi:application

[Install]
WantedBy=multi-user.target
